# Dockerfile for Genome Assembly Studio Web Frontend (Next.js 15)

FROM node:22-bookworm-slim AS base
RUN corepack enable && corepack prepare pnpm@10.5.2 --activate
WORKDIR /app

FROM base AS builder
WORKDIR /app

COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
COPY apps/web/package.json ./apps/web/
COPY packages/ui/package.json ./packages/ui/
COPY packages/visualization/package.json ./packages/visualization/

RUN pnpm install --frozen-lockfile

COPY packages ./packages
COPY apps/web ./apps/web

ENV NEXT_TELEMETRY_DISABLED=1
ENV NODE_ENV=production
ENV BROWSERSLIST="defaults"

RUN pnpm --filter @genome-studio/ui build && \
    pnpm --filter @genome-studio/visualization build && \
    pnpm --filter web build

FROM base AS runner
WORKDIR /app

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=3000

COPY --from=builder /app/package.json ./
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/apps/web/package.json ./apps/web/
COPY --from=builder /app/apps/web/next.config.ts ./apps/web/
COPY --from=builder /app/apps/web/public ./apps/web/public
COPY --from=builder /app/apps/web/.next ./apps/web/.next
COPY --from=builder /app/packages ./packages

EXPOSE 3000

WORKDIR /app/apps/web
CMD ["node", "../../node_modules/.pnpm/next@15.2.1_react-dom@19.3.1_react@19.3.1__react@19.3.1/node_modules/next/dist/bin/next", "start"]
