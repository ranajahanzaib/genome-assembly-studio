# Genome Assembly Studio Environment Variables

# Backend API Configuration
ENVIRONMENT=development
LOG_LEVEL=info
DATABASE_URL=sqlite:///./genome_studio.db
DATA_DIR=./data
SEED_DEMO_DATA=true
PORT=8000

# Rust Binary Location (defaults to system PATH or target/release/genome-studio)
GENOME_STUDIO_BIN=./target/debug/genome-studio

# Optional External Scientific Executables
QUAST_BIN=quast
BUSCO_BIN=busco
CHECKM2_BIN=checkm2
MINIMAP2_BIN=minimap2

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
PORT=3000
